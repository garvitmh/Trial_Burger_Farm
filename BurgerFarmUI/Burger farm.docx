}

class _LogoWithRings extends StatelessWidget {
  final AnimationController pulseController;
  final AnimationController fadeController;
  
  const _LogoWithRings({
    required this.pulseController,
    required this.fadeController,
  });
  
  @override
  Widget build(BuildContext context) {
    return FadeTransition(
      opacity: fadeController,
      child: SizedBox(
        width: 96,
        height: 96,
        child: Stack(
          alignment: Alignment.center,
          children: [
            // Outer pulse ring
            AnimatedBuilder(
              animation: pulseController,
              builder: (context, child) {
                return Container(
                  width: 96 + (pulseController.value * 20),
                  height: 96 + (pulseController.value * 20),
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    border: Border.all(
                      color: Colors.white.withOpacity(
                        0.3 * (1 - pulseController.value),
                      ),
                      width: 1,
                    ),
                  ),
                );
              },
            ),
            // Inner pulse ring (delayed)
            AnimatedBuilder(
              animation: pulseController,
              builder: (context, child) {
                final delayedValue = ((pulseController.value + 0.5) % 1.0);
                return Container(
                  width: 96 + (delayedValue * 20),
                  height: 96 + (delayedValue * 20),
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    border: Border.all(
                      color: Colors.white.withOpacity(
                        0.2 * (1 - delayedValue),
                      ),
                      width: 1,
                    ),
                  ),
                );
              },
            ),
            // Glassmorphism logo container
            Container(
              width: 96,
              height: 96,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: Colors.white.withOpacity(0.1),
                border: Border(
                  top: BorderSide(
                    color: Colors.white.withOpacity(0.4),
                    width: 1,
                  ),
                  bottom: BorderSide(
                    color: Colors.white.withOpacity(0.1),
                    width: 1,
                  ),
                ),
                boxShadow: [
                  BoxShadow(
                    color: const Color(0xFF271200).withOpacity(0.25),
                    blurRadius: 40,
                    offset: const Offset(0, 12),
                  ),
                  BoxShadow(
                    color: Colors.white.withOpacity(0.2),
                    blurRadius: 4,
                    offset: const Offset(0, 2),
                    inset: true,
                  ),
                ],
              ),
              child: Center(
                child: _BurgerIcon(size: 56),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _BurgerIcon extends StatelessWidget {
  final double size;
  
  const _BurgerIcon({required this.size});
  
  @override
  Widget build(BuildContext context) {
    return CustomPaint(
      size: Size(size, size),
      painter: _BurgerIconPainter(),
    );
  }
}

class _BurgerIconPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()..color = Colors.white;
    
    // Bottom bun
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(size.width * 0.2, size.height * 0.56, 
                      size.width * 0.6, size.height * 0.19),
        Radius.circular(size.width * 0.09),
      ),
      paint..color = Colors.white.withOpacity(0.95),
    );
    
    // Patty
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(size.width * 0.17, size.height * 0.46, 
                      size.width * 0.66, size.height * 0.12),
        Radius.circular(size.width * 0.06),
      ),
      paint..color = Colors.white.withOpacity(0.7),
    );
    
    // Cheese/Toppings
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(size.width * 0.23, size.height * 0.38, 
                      size.width * 0.54, size.height * 0.10),
        Radius.circular(size.width * 0.05),
      ),
      paint..color = Colors.white.withOpacity(0.9),
    );
    
    // Top bun
    canvas.drawRRect(
      RRect.fromRectAndRadius(
        Rect.fromLTWH(size.width * 0.19, size.height * 0.29, 
                      size.width * 0.62, size.height * 0.10),
        Radius.circular(size.width * 0.05),
      ),
      paint..color = Colors.white.withOpacity(0.5),
    );
  }
  
  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

class _AmbientOrb extends StatelessWidget {
  final double size;
  final Color color;
  final AnimationController animation;
  final double delay;
  
  const _AmbientOrb({
    required this.size,
    required this.color,
    required this.animation,
    this.delay = 0,
  });
  
  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: animation,
      builder: (context, child) {
        final adjustedValue = ((animation.value + delay) % 1.0);
        return Container(
          width: size,
          height: size,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: color.withOpacity(0.2 + (adjustedValue * 0.1)),
          ),
          child: BackdropFilter(
            filter: ImageFilter.blur(
              sigmaX: size * 0.25,
              sigmaY: size * 0.25,
            ),
            child: Container(
              color: Colors.transparent,
            ),
          ),
        );
      },
    );
  }
}

class _OrbitAnimation extends StatelessWidget {
  final AnimationController controller;
  
  const _OrbitAnimation({required this.controller});
  
  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: 192,
      height: 80,
      child: AnimatedBuilder(
        animation: controller,
        builder: (context, child) {
          return CustomPaint(
            size: const Size(192, 80),
            painter: _OrbitPathPainter(progress: controller.value),
          );
        },
      ),
    );
  }
}

class _OrbitPathPainter extends CustomPainter {
  final double progress;
  
  _OrbitPathPainter({required this.progress});
  
  @override
  void paint(Canvas canvas, Size size) {
    final path = Path()
      ..moveTo(10, size.height - 10)
      ..quadraticBezierTo(
        size.width * 0.5, -20,
        size.width - 10, size.height - 10,
      );
    
    final paint = Paint()
      ..color = Colors.white.withOpacity(0.3)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5
      ..strokeCap = StrokeCap.round;
    
    // Draw path with animation
    final pathMetrics = path.computeMetrics();
    for (final metric in pathMetrics) {
      final extractPath = metric.extractPath(
        0,
        metric.length * progress,
      );
      canvas.drawPath(extractPath, paint);
    }
  }
  
  @override
  bool shouldRepaint(covariant _OrbitPathPainter oldDelegate) => 
      oldDelegate.progress != progress;
}

class _LoadingBar extends StatefulWidget {
  @override
  State<_LoadingBar> createState() => _LoadingBarState();
}

class _LoadingBarState extends State<_LoadingBar> 
    with SingleTickerProviderStateMixin {
  late AnimationController _controller;
  
  @override
  void initState() {
    super.initState();
    _controller = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 2),
    )..repeat();
  }
  
  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }
  
  @override
  Widget build(BuildContext context) {
    return AnimatedBuilder(
      animation: _controller,
      builder: (context, child) {
        return Container(
          width: 128,
          height: 6,
          decoration: BoxDecoration(
            color: Colors.white.withOpacity(0.1),
            borderRadius: BorderRadius.circular(3),
          ),
          child: Stack(
            children: [
              Positioned(
                left: -128 + (_controller.value * 384),
                child: Container(
                  width: 128 * 0.4,
                  height: 6,
                  decoration: BoxDecoration(
                    color: Colors.white.withOpacity(0.9),
                    borderRadius: BorderRadius.circular(3),
                  ),
                ),
              ),
            ],
          ),
        );
      },
    );
  }
}

class _WavePainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.white.withOpacity(0.8)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2.5
      ..strokeCap = StrokeCap.round;
    
    final path = Path()
      ..moveTo(0, size.height * 0.5)
      ..quadraticBezierTo(
        size.width * 0.25, 0,
        size.width * 0.5, size.height * 0.5,
      )
      ..quadraticBezierTo(
        size.width * 0.75, size.height,
        size.width, size.height * 0.5,
      );
    
    canvas.drawPath(path, paint);
  }
  
  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}






