          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            icon,
            const SizedBox(width: 12),
            Text(
              label,
              style: AppTypography.body(
                size: 14,
                weight: FontWeight.w600,
                color: textColor ?? AppColors.brown,
              ),
            ),
          ],
        ),
      ),
