  firebase_analytics: ^10.8.0
  
  # Maps & Location
  google_maps_flutter: ^2.5.0
  geolocator: ^10.1.0
  google_maps_webservice: ^0.0.20
  
  # Auth
  sign_in_with_apple: ^5.0.0
  google_sign_in: ^6.1.0
  
  # UI
  google_fonts: ^6.1.0
  shimmer: ^3.0.0
  cached_network_image: ^3.3.0
  
  # Utils
  freezed_annotation: ^2.4.0
  json_annotation: ^4.8.0
  uuid: ^4.2.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^3.0.0
  build_runner: ^2.4.0
  freezed: ^2.4.0
  json_serializable: ^6.7.0
  riverpod_generator: ^2.3.0

flutter:
  uses-material-design: true
  
  assets:
    - assets/
    - assets/fonts/
    - assets/images/
  
  fonts:
    - family: MontreuxClassic
      fonts:
        - asset: assets/fonts/MontreuxClassic-Regular.ttf
          weight: 400
        - asset: assets/fonts/MontreuxClassic-Bold.ttf
          weight: 700
    - family: Recoleta
      fonts:
        - asset: assets/fonts/Recoleta-Regular.ttf
          weight: 400
        - asset: assets/fonts/Recoleta-Medium.ttf
          weight: 500
        - asset: assets/fonts/Recoleta-SemiBold.ttf
          weight: 600
        - asset: assets/fonts/Recoleta-Bold.ttf
          weight: 700


