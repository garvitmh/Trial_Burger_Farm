│   ├── constants/          # App constants, routes, enums
│   ├── utils/              # Extensions, helpers, responsive utilities
│   └── animations/         # Reusable animation controllers & presets
├── data/
│   ├── models/             # Freezed data classes
│   ├── repositories/       # Abstract repository interfaces
│   └── services/           # Firebase, Maps, Auth services
├── domain/
│   ├── entities/           # Business entities
│   └── providers/          # Riverpod state management
├── presentation/
│   ├── screens/            # All 9 screens from HTML
│   ├── widgets/            # Atomic design components
│   └── router/             # GoRouter configuration
└── main.dart


### `lib/core/theme/app_colors.dart`

import 'package:flutter/material.dart';

/// Exact color extraction from Tailwind config:
/// brand: { DEFAULT: '#E8560A', hover: '#C94208', light: '#FFF0E5' }
/// brown: { DEFAULT: '#271200', muted: 'rgba(39, 18, 0, 0.42)', light: 'rgba(39, 18, 0, 0.06)' }
/// cream: '#FBF7F2', line: '#EBE1D6'
class AppColors {
  AppColors._();
  
  // Brand Orange
  static const Color brand = Color(0xFFE8560A);
  static const Color brandHover = Color(0xFFC94208);
  static const Color brandLight = Color(0xFFFFF0E5);
  
  // Brown Palette
  static const Color brown = Color(0xFF271200);
  static const Color cream = Color(0xFFFBF7F2);
  static const Color line = Color(0xFFEBE1D6);
  
  // Semantic Colors
  static const Color success = Color(0xFF1A7A38);
  static const Color danger = Color(0xFFC0001A);
  
  // Derived with exact opacity values from HTML
  static Color get brownMuted => brown.withOpacity(0.42);
  static Color get brownLight => brown.withOpacity(0.06);
  static Color get whiteMuted => Colors.white.withOpacity(0.80);
  
  // Background colors matching HTML body backgrounds
  static const Color warmBg = Color(0xFFF5EFE6);
  static const Color whiteBg = Colors.white;
  static const Color brandBg = brand;
}

/// Material Color generation for ThemeData
Map<int, Color> _brandSwatch = {
  50: const Color(0xFFFFF0E5),
  100: const Color(0xFFFFD9C2),
  200: const Color(0xFFFFB894),
  300: const Color(0xFFFF965C),
  400: const Color(0xFFFF7A33),
  500: const Color(0xFFE8560A),
  600: const Color(0xFFC94208),
  700: const Color(0xFFA83606),
  800: const Color(0xFF872A04),
  900: const Color(0xFF661F03),
};



### `lib/core/theme/app_typography.dart`
import 'package:flutter/material.dart';
import 'package:google_fonts/google_fonts.dart';

/// Font mapping from HTML:
/// display: ['"Montreux Classic"', 'sans-serif'] → Use Syne or Archivo Black as closest Google Font
/// sans: ['"Recoleta"', 'serif'] → Use DM Serif Display or Fraunces
/// 
/// For production: Download Montreux & Recoleta WOFF2, convert to TTF, add to assets/fonts/
class AppTypography {
  AppTypography._();
  
  // Fallback to Google Fonts until custom fonts are loaded
  static String get displayFont => 'MontreuxClassic'; // Custom
  static String get bodyFont => 'Recoleta'; // Custom
  
  static TextStyle display({
    double size = 16,
    FontWeight weight = FontWeight.w900,
    Color? color,
    double letterSpacing = 0.15,
    double? height,
    List<Shadow>? shadows,
  }) {
    return TextStyle(
      fontFamily: displayFont,
      fontSize: size,
      fontWeight: weight,
      color: color ?? AppColors.brown,
      letterSpacing: letterSpacing,
      height: height,
      shadows: shadows,
    );
  }
  
  static TextStyle body({
    double size = 14,
    FontWeight weight = FontWeight.w500,
    Color? color,
    double letterSpacing = 0,
    double? height,
    FontStyle? style,
  }) {
    return TextStyle(
      fontFamily: bodyFont,
      fontSize: size,
      fontWeight: weight,
      color: color ?? AppColors.brown,
      letterSpacing: letterSpacing,
      height: height,
      fontStyle: style,
    );
  }
  
  // Predefined styles matching HTML exactly
  static TextStyle get splashTitle => display(
    size: 64,
    color: Colors.white,
    letterSpacing: -0.03,
    height: 0.85,
    shadows: [
      Shadow(
        color: AppColors.brown.withOpacity(0.2),
        blurRadius: 16,
        offset: const Offset(0, 4),
      ),
    ],
  );
  
  static TextStyle get onboardingHeadline => display(
    size: 40,
    height: 1.05,
    letterSpacing: -0.025,
  );
  
  static TextStyle get screenTitle => display(
    size: 18,
    letterSpacing: 0.15,
  );
  
  static TextStyle get bodyLarge => body(
    size: 15,
    height: 1.65,
    color: AppColors.brownMuted,
  );
  
  static TextStyle get labelSmall => body(
    size: 10,
    weight: FontWeight.w900,
    letterSpacing: 0.2,
    color: AppColors.brownMuted,
  );
}


### `lib/core/theme/app_shadows.dart`

import 'package:flutter/material.dart';
import 'app_colors.dart';

/// Exact shadow definitions from Tailwind config:
/// soft: '0 4px 24px rgba(39, 18, 0, 0.04), 0 1px 2px rgba(39, 18, 0, 0.02)'
/// premium: '0 20px 40px -10px rgba(39,18,0,0.08), 0 1px 3px rgba(39,18,0,0.05)'
/// glow: '0 8px 24px rgba(232, 86, 10, 0.25)'
class AppShadows {
  AppShadows._();
  
  static List<BoxShadow> get soft => [
    BoxShadow(
      color: AppColors.brown.withOpacity(0.04),
      blurRadius: 24,
      offset: const Offset(0, 4),
    ),
    BoxShadow(
      color: AppColors.brown.withOpacity(0.02),
      blurRadius: 2,
      offset: const Offset(0, 1),
    ),
  ];
  
  static List<BoxShadow> get premium => [
    BoxShadow(
      color: AppColors.brown.withOpacity(0.08),
      blurRadius: 40,
      spreadRadius: -10,
      offset: const Offset(0, 20),
    ),
    BoxShadow(
      color: AppColors.brown.withOpacity(0.05),
      blurRadius: 3,
      offset: const Offset(0, 1),
    ),
  ];
  
  static List<BoxShadow> get glow => [
    BoxShadow(
      color: AppColors.brand.withOpacity(0.25),
      blurRadius: 24,
      offset: const Offset(0, 8),
    ),
  ];
  
  static List<BoxShadow> get brandGlow => [
    BoxShadow(
      color: AppColors.brand.withOpacity(0.4),
      blurRadius: 30,
      spreadRadius: -10,
      offset: const Offset(0, 10),
    ),
    BoxShadow(
      color: AppColors.brand.withOpacity(0.2),
      blurRadius: 10,
      offset: const Offset(0, 4),
    ),
  ];
  
  static List<BoxShadow> get float => [
    BoxShadow(
      color: AppColors.brown.withOpacity(0.04),
      blurRadius: 32,
      offset: const Offset(0, -12),
    ),
  ];
  
  static List<BoxShadow> get insetSoft => [
    BoxShadow(
      color: AppColors.brown.withOpacity(0.04),
      blurRadius: 8,
      offset: const Offset(0, 2),
    ),
  ];
}




### `lib/core/theme/app_animations.dart`
import 'package:flutter/material.dart';

/// Animation curves and durations matching GSAP/GSAP-like easing
/// spring: 'cubic-bezier(0.16, 1, 0.3, 1)' → Curves.easeOutBack approx
class AppAnimations {
  AppAnimations._();
  
  // Curves
  static const Curve spring = Cubic(0.16, 1, 0.3, 1);
  static const Curve expoOut = Cubic(0.16, 1, 0.3, 1); // Same as spring in config
  static const Curve backOut = Curves.easeOutBack;
  
  // Durations
  static const Duration fast = Duration(milliseconds: 200);
  static const Duration normal = Duration(milliseconds: 300);
  static const Duration slow = Duration(milliseconds: 500);
  static const Duration entrance = Duration(milliseconds: 800);
  
  // Stagger delays
  static const Duration staggerItem = Duration(milliseconds: 100);
  
  // Preset Tween sequences for common animations
  static Widget fadeUp({
    required Widget child,
    required Animation<double> animation,
    double startY = 20,
  }) {
    return AnimatedBuilder(
      animation: animation,
      builder: (context, child) {
        return Opacity(
          opacity: animation.value,
          child: Transform.translate(
            offset: Offset(0, startY * (1 - animation.value)),
            child: child,
          ),
        );
      },
      child: child,
    );
  }
  
  static AnimationController createEntranceController(TickerProvider vsync) {
    return AnimationController(
      vsync: vsync,
      duration: entrance,
    );
  }
}




## 2. Responsive Foundation

### `lib/core/utils/responsive.dart`


import 'package:flutter/material.dart';

/// Ensures UI works on any screen size while maintaining the mobile-first
/// design intent. The HTML uses max-w-[400px] with centered layout.
class Responsive {
  static const double designWidth = 400;
  static const double designHeight = 850;
  
  /// Returns constrained width that mimics the HTML max-w-[400px] behavior
  /// On phones < 400px, uses full width. On tablets/desktop, centers with max width.
  static double contentWidth(BuildContext context) {
    final screenWidth = MediaQuery.of(context).size.width;
    return screenWidth.clamp(0, designWidth);
  }
  
  /// Scale factor relative to design width
  static double scale(BuildContext context) {
    return contentWidth(context) / designWidth;
  }
  
  /// Responsive padding that scales with screen size
  static EdgeInsets symmetric({
    BuildContext? context,
    double horizontal = 24,
    double vertical = 0,
  }) {
    final s = context != null ? scale(context) : 1.0;
    return EdgeInsets.symmetric(
      horizontal: horizontal * s,
      vertical: vertical * s,
    );
  }
  
  /// Safe area insets combined with responsive padding
  static EdgeInsets safePadding(BuildContext context) {
    final mq = MediaQuery.of(context);
    return EdgeInsets.only(
      top: mq.padding.top,
      bottom: mq.padding.bottom,
      left: mq.padding.left.clamp(0, 16),
      right: mq.padding.right.clamp(0, 16),
    );
  }
}

/// Widget that wraps content in a centered, max-width container like HTML
class AppContainer extends StatelessWidget {
  final Widget child;
  final Color? backgroundColor;
  final EdgeInsets? padding;
  
  const AppContainer({
    super.key,
    required this.child,
    this.backgroundColor,
    this.padding,
  });
  
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: backgroundColor ?? AppColors.warmBg,
      body: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: Responsive.designWidth),
          child: Container(
            width: double.infinity,
            height: double.infinity,
            decoration: BoxDecoration(
              color: backgroundColor ?? Colors.white,
              borderRadius: _getBorderRadius(context),
              boxShadow: _getShadow(context),
            ),
            clipBehavior: Clip.antiAlias,
            child: MediaQuery(
              // Remove system padding since we handle it internally
              data: MediaQuery.of(context).removePadding(
                removeTop: true,
                removeBottom: true,
              ),
              child: Padding(
                padding: padding ?? EdgeInsets.zero,
                child: child,
              ),
            ),
          ),
        ),
      ),
    );
  }
  
  BorderRadius? _getBorderRadius(BuildContext context) {
    // Only round corners on larger screens (simulating sm:rounded-[40px])
    final width = MediaQuery.of(context).size.width;
    if (width > Responsive.designWidth) {
      return BorderRadius.circular(40);
    }
    return null;
  }
  
  List<BoxShadow>? _getShadow(BuildContext context) {
    final width = MediaQuery.of(context).size.width;
    if (width > Responsive.designWidth) {
      return [
        BoxShadow(
          color: Colors.black.withOpacity(0.2),
          blurRadius: 40,
          offset: const Offset(0, 20),
        ),
      ];
    }
    return null;
  }
}




## 3. Reusable Widgets (Atomic Design)

### `lib/presentation/widgets/premium_button.dart`

import 'package:flutter/material.dart';
import '../../core/theme/app_colors.dart';
import '../../core/theme/app_shadows.dart';
import '../../core/theme/app_animations.dart';

/// The signature CTA button used across all screens.
/// Matches: bg-brand, shadow-brand-glow, active:scale-[0.97], shimmer effect
class PremiumButton extends StatefulWidget {
  final String text;
  final VoidCallback? onPressed;
  final Widget? icon;
  final bool isLoading;
  final Color? backgroundColor;
  final Color? textColor;
  
  const PremiumButton({
    super.key,
    required this.text,
    this.onPressed,
    this.icon,
    this.isLoading = false,
    this.backgroundColor,
    this.textColor,
  });
  
  @override
  State<PremiumButton> createState() => _PremiumButtonState();
}

class _PremiumButtonState extends State<PremiumButton> 
    with SingleTickerProviderStateMixin {
  late AnimationController _pressController;
  late Animation<double> _scaleAnimation;
  
  @override
  void initState() {
    super.initState();
    _pressController = AnimationController(
      vsync: this,
      duration: AppAnimations.fast,
    );
    _scaleAnimation = Tween<double>(begin: 1.0, end: 0.97).animate(
      CurvedAnimation(parent: _pressController, curve: AppAnimations.spring),
    );
  }
  
  @override
  void dispose() {
    _pressController.dispose();
    super.dispose();
  }
  
  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTapDown: (_) => _pressController.forward(),
      onTapUp: (_) {
        _pressController.reverse();
        widget.onPressed?.call();
      },
      onTapCancel: () => _pressController.reverse(),
      child: AnimatedBuilder(
        animation: _scaleAnimation,
        builder: (context, child) {
          return Transform.scale(
            scale: _scaleAnimation.value,
            child: Container(
              height: 56,
              decoration: BoxDecoration(
                color: widget.backgroundColor ?? AppColors.brand,
                borderRadius: BorderRadius.circular(20),
                boxShadow: AppShadows.brandGlow,
              ),
              child: ClipRRect(
                borderRadius: BorderRadius.circular(20),
                child: Stack(
                  children: [
                    // Shimmer effect on hover/tap
                    Positioned.fill(
                      child: AnimatedContainer(
                        duration: const Duration(milliseconds: 700),
                        decoration: BoxDecoration(
                          gradient: LinearGradient(
                            colors: [
                              Colors.transparent,
                              Colors.white.withOpacity(0.2),
                              Colors.transparent,
                            ],
                            stops: const [0.0, 0.5, 1.0],
                          ),
                        ),
                      ),
                    ),
                    // Content
                    Center(
                      child: widget.isLoading
                          ? const SizedBox(
                              width: 24,
                              height: 24,
                              child: CircularProgressIndicator(
                                color: Colors.white,
                                strokeWidth: 2.5,
                              ),
                            )
                          : Row(
                              mainAxisAlignment: MainAxisAlignment.center,
                              children: [
                                Text(
                                  widget.text,
                                  style: TextStyle(
                                    fontFamily: AppTypography.displayFont,
                                    fontSize: 16,
                                    fontWeight: FontWeight.w700,
                                    color: widget.textColor ?? Colors.white,
                                  ),
                                ),
                                if (widget.icon != null) ...[
                                  const SizedBox(width: 8),
                                  widget.icon!,
                                ],
                              ],
                            ),
                    ),
                  ],
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}



### `lib/presentation/widgets/premium_input.dart`

import 'package:flutter/material.dart';
import '../../core/theme/app_colors.dart';
import '../../core/theme/app_shadows.dart';

/// Input field matching HTML: bg-[#FAFAFA], border-[1.5px], rounded-2xl,
/// focus:border-brand, focus:shadow-[0_8px_24px_rgba(232,86,10,0.15)]
class PremiumInput extends StatefulWidget {
  final String? label;
  final String? placeholder;
  final Widget? prefixIcon;
  final Widget? suffixIcon;
  final TextInputType? keyboardType;
  final bool obscureText;
  final ValueChanged<String>? onChanged;
  final TextEditingController? controller;
  final bool required;
  
  const PremiumInput({
    super.key,
    this.label,
    this.placeholder,
    this.prefixIcon,
    this.suffixIcon,
    this.keyboardType,
    this.obscureText = false,
    this.onChanged,
    this.controller,
    this.required = false,
  });
  
  @override
  State<PremiumInput> createState() => _PremiumInputState();
}

class _PremiumInputState extends State<PremiumInput> {
  bool _isFocused = false;
  
  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        if (widget.label != null) ...[
          Row(
            children: [
              Text(
                widget.label!,
                style: AppTypography.body(
                  size: 12,
                  weight: FontWeight.w700,
                  letterSpacing: 0.1,
                  color: AppColors.brownMuted,
                ).copyWith(
                  shadows: [
                    Shadow(
                      color: Colors.white.withOpacity(0.8),
                      blurRadius: 0,
                      offset: const Offset(0, 1),
                    ),
                  ],
                ),
              ),
              if (widget.required)
                Text(
                  ' *',
                  style: AppTypography.body(
                    size: 12,
                    color: AppColors.brand,
                  ),
                ),
            ],
          ),
          const SizedBox(height: 10),
        ],
        Focus(
          onFocusChange: (focused) => setState(() => _isFocused = focused),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 300),
            curve: AppAnimations.spring,
            decoration: BoxDecoration(
              color: _isFocused ? Colors.white : const Color(0xFFFAFAFA),
              borderRadius: BorderRadius.circular(16),
              border: Border.all(
                color: _isFocused 
                    ? AppColors.brand.withOpacity(0.4) 
                    : AppColors.line,
                width: 1.5,
              ),
              boxShadow: _isFocused
                  ? [
                      BoxShadow(
                        color: AppColors.brand.withOpacity(0.15),
                        blurRadius: 24,
                        offset: const Offset(0, 8),
                      ),
                      ...AppShadows.insetSoft,
                    ]
                  : AppShadows.insetSoft,
            ),
            child: Row(
              children: [
                if (widget.prefixIcon != null) ...[
                  const SizedBox(width: 16),
                  widget.prefixIcon!,
                  const SizedBox(width: 12),
                ],
                Expanded(
                  child: TextField(
                    controller: widget.controller,
                    keyboardType: widget.keyboardType,
                    obscureText: widget.obscureText,
                    onChanged: widget.onChanged,
                    style: AppTypography.body(
                      size: 16,
                      weight: FontWeight.w700,
                    ),
                    decoration: InputDecoration(
                      hintText: widget.placeholder,
                      hintStyle: AppTypography.body(
                        size: 16,
                        color: AppColors.brownMuted.withOpacity(0.4),
                      ),
                      border: InputBorder.none,
                      contentPadding: const EdgeInsets.symmetric(
                        vertical: 16,
                        horizontal: 4,
                      ),
                    ),
                  ),
                ),
                if (widget.suffixIcon != null) ...[
                  const SizedBox(width: 12),
                  widget.suffixIcon!,
                  const SizedBox(width: 16),
                ],
              ],
            ),
          ),
        ),
      ],
    );
  }
}



	### `lib/presentation/widgets/noise_overlay.dart`
	import 'package:flutter/material.dart';

/// Replicates the premium noise overlay from HTML:
/// opacity: 0.025, fractalNoise baseFrequency='0.65'
class NoiseOverlay extends StatelessWidget {
  const NoiseOverlay({super.key});
  
  @override
  Widget build(BuildContext context) {
    return IgnorePointer(
      child: Opacity(
        opacity: 0.025,
        child: Container(
          decoration: const BoxDecoration(
            // Using a generated noise pattern or shader would be ideal
            // For now, using a subtle pattern approximation
            color: Colors.transparent,
          ),
          child: CustomPaint(
            size: Size.infinite,
            painter: _NoisePainter(),
          ),
        ),
      ),
    );
  }
}

class _NoisePainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final paint = Paint()
      ..color = Colors.black.withOpacity(0.02)
      ..strokeWidth = 1;
    
    // Simple noise approximation - in production use a shader or image
    final random = Random(42); // Fixed seed for consistency
    for (var i = 0; i < size.width * size.height * 0.1; i++) {
      final x = random.nextDouble() * size.width;
      final y = random.nextDouble() * size.height;
      canvas.drawCircle(Offset(x, y), 0.5, paint);
    }
  }
  
  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}




## 4. Screen Implementations

### `lib/presentation/screens/splash_screen.dart`


import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:go_router/go_router.dart';
import '../../core/theme/app_colors.dart';
import '../../core/theme/app_animations.dart';
import '../../core/theme/app_typography.dart';
import '../router/app_router.dart';

/// Splash Screen with exact animations:
/// - Orbit path animation (GSAP motionPath equivalent)
/// - Pulse rings around logo
/// - Loading bar slide animation
/// - Fade-up entrance for typography
class SplashScreen extends ConsumerStatefulWidget {
  const SplashScreen({super.key});
  
  @override
  ConsumerState<SplashScreen> createState() => _SplashScreenState();
}

class _SplashScreenState extends ConsumerState<SplashScreen> 
    with TickerProviderStateMixin {
  late AnimationController _orbitController;
  late AnimationController _fadeController;
  late AnimationController _pulseController;
  
  @override
  void initState() {
    super.initState();
    
    _orbitController = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 4),
    )..repeat();
    
    _fadeController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 1200),
    );
    
    _pulseController = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 2),
    )..repeat();
    
    // Staggered entrance
    Future.delayed(const Duration(milliseconds: 200), () {
      _fadeController.forward();
    });
    
    // Auto-navigate after animation
    Future.delayed(const Duration(seconds: 3), () {
      if (mounted) context.go(AppRoute.onboarding);
    });
  }
  
  @override
  void dispose() {
    _orbitController.dispose();
    _fadeController.dispose();
    _pulseController.dispose();
    super.dispose();
  }
  
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.brand,
      body: GestureDetector(
        onTap: () => context.go(AppRoute.onboarding),
        child: Stack(
          children: [
            // Background gradients matching HTML
            Positioned.fill(
              child: Container(
                decoration: BoxDecoration(
                  gradient: RadialGradient(
                    center: const Alignment(0.5, -0.3),
                    radius: 0.8,
                    colors: [
                      Colors.white.withOpacity(0.12),
                      Colors.transparent,
                    ],
                  ),
                ),
              ),
            ),
            
            // Floating ambient orbs
            Positioned(
              top: MediaQuery.of(context).size.height * 0.2,
              left: MediaQuery.of(context).size.width * 0.1,
              child: _AmbientOrb(
                size: 256,
                color: const Color(0xFFFFB085),
                animation: _pulseController,
              ),
            ),
            Positioned(
              bottom: MediaQuery.of(context).size.height * 0.2,
              right: MediaQuery.of(context).size.width * 0.1,
              child: _AmbientOrb(
                size: 288,
                color: const Color(0xFFC94208),
                animation: _pulseController,
                delay: 0.5,
              ),
            ),
            
            // Center content
            Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  // Logo with pulse rings
                  _LogoWithRings(
                    pulseController: _pulseController,
                    fadeController: _fadeController,
                  ),
                  
                  const SizedBox(height: 32),
                  
                  // Typography with fade-up
                  FadeTransition(
                    opacity: CurvedAnimation(
                      parent: _fadeController,
                      curve: const Interval(0.2, 1.0, curve: AppAnimations.expoOut),
                    ),
                    child: SlideTransition(
                      position: Tween<Offset>(
                        begin: const Offset(0, 30),
                        end: Offset.zero,
                      ).animate(CurvedAnimation(
                        parent: _fadeController,
