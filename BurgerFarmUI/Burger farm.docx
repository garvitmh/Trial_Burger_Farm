                          const SizedBox(height: 16),
                          Text(
                            'Farm-Fresh. Always.',
                            style: AppTypography.display(
                              size: 20,
                              color: Colors.white.withOpacity(0.95),
                              style: FontStyle.italic,
                              letterSpacing: 0.02,
