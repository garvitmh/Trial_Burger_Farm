              children: [
                // Map pattern background
                Container(
                  decoration: const BoxDecoration(
                    color: Color(0xFFF0F0F0),
                  ),
                  child: CustomPaint(
                    size: Size.infinite,
                    painter: _MapPatternPainter(),
                  ),
                ),
                
