class _CategoryItem extends StatelessWidget {
  final IconData icon;
  final String label;
  final bool isActive;
  
  const _CategoryItem({
    required this.icon,
    required this.label,
    this.isActive = false,
  });
  
  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        AnimatedContainer(
          duration: const Duration(milliseconds: 300),
          curve: AppAnimations.spring,
          width: 64,
          height: 64,
          decoration: BoxDecoration(
            color: isActive ? AppColors.brand : Colors.white,
            borderRadius: BorderRadius.circular(20),
            border: isActive
                ? Border.all(color: Colors.white.withOpacity(0.2))
                : Border.all(color: AppColors.line.withOpacity(0.6)),
            boxShadow: isActive ? AppShadows.brandGlow : AppShadows.premium,
          ),
          child: Icon(
            icon,
            size: 28,
            color: isActive ? Colors.white : AppColors.brand,
          ),
        ),
        const SizedBox(height: 8),
        Text(
          label,
          style: AppTypography.body(
            size: 12,
            weight: FontWeight.w700,
            color: isActive ? AppColors.brown : AppColors.brownMuted,
          ),
        ),
      ],
    );
  }
}

